# Janus Environment Variables
# Copy this file to .env and fill in your values

# Flask environment: development, production, testing
FLASK_ENV=development

# Secret key for session security (generate a strong random string for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-string

# Database connection string
# SQLite (default for development): sqlite:///janus_dev.db
# MySQL: mysql+pymysql://user:password@localhost/janus
# PostgreSQL: postgresql://user:password@localhost/janus
# DATABASE_URL=mysql+pymysql://user:password@localhost/janus

# Admin email addresses (comma-separated)
ADMINS=admin@example.com

# Redis URL for rate limiting (production)
# REDIS_URL=redis://localhost:6379

# Security
# Password reset salt (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# SECURITY_PASSWORD_SALT=change-this-too
